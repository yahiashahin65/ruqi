# =========================================================
# Site
# =========================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=966502354855
NEXT_PUBLIC_PHONE=0502354855
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_SNAPCHAT=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set false before launch if you never want fallback demo projects/content
NEXT_PUBLIC_DEMO_CONTENT=false

# =========================================================
# Firebase Client (Project settings > General > Web app)
# Browser-safe Firebase configuration. Used for Admin login only.
# =========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =========================================================
# Firebase Admin (Project settings > Service accounts)
# Server-only. NEVER prefix these with NEXT_PUBLIC_.
# On Vercel you can paste private_key from the downloaded service-account JSON directly.
# Mark FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY as Sensitive/Secret.
# FIREBASE_PRIVATE_KEY_BASE64 remains optional only for backwards compatibility.
# =========================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
ADMIN_UID=
# FIREBASE_PRIVATE_KEY_BASE64=

# =========================================================
# Cloudflare R2
# One scoped Read/Write API token may access BOTH buckets.
# Public bucket: portfolio / service / article media.
# Private bucket: client plans and lead attachments.
# =========================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=decor-line-public-media
R2_PRIVATE_BUCKET=decor-line-private-uploads

# Custom domain recommended in production, e.g. https://media.example.com
# r2.dev is acceptable for development only.
R2_PUBLIC_BASE_URL=

# =========================================================
# Optional Cloudflare Turnstile for public lead protection
# =========================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =========================================================
# Seed only - do not expose publicly
# =========================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisImmediately123!
